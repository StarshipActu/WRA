# --- Discord (obligatoire) ---
DISCORD_TOKEN=colle_ton_token_ici
# Un seul salon pour tout...
CHANNEL_ID=123456789012345678
# ...ou un salon par type (optionnel, sinon CHANNEL_ID est utilisé)
#CHANNEL_TFR=
#CHANNEL_NOTAM=
#CHANNEL_NAVAREA=

# --- Fonctionnement ---
POLL_MINUTES=5
POST_EXISTING_ON_FIRST_RUN=0
LOCAL_TZ=Europe/Paris

# --- Filtres TFR (* = tout garder ; vide = valeur par défaut) ---
TFR_TYPES=SPACE OPERATIONS,HAZARDS
TFR_STATES=TX,FL
# Lieux exigés pour les TFR HAZARDS (* = tous)
TFR_PLACES=BROWNSVILLE,SOUTH PADRE,BOCA CHICA,PORT ISABEL,CAPE CANAVERAL,TITUSVILLE,COCOA,MERRITT ISLAND,KENNEDY,ORLANDO

# --- NAVAREA IV : 1 = poster tous les avis, 0 = seulement ceux liés aux lancements ---
NAVAREA_ALL=0

# --- NOTAM classiques (optionnel, clés gratuites sur https://api.faa.gov) ---
#FAA_CLIENT_ID=
#FAA_CLIENT_SECRET=

# --- Carte ---
# liberty (carte classique, défaut) | bright | positron (clair) | fiord (sombre) | satellite (USGS, USA) | satellite-esri (monde) | URL de style
MAP_STYLE=liberty
# Style spécifique par type (optionnel) : MAP_STYLE_TFR, MAP_STYLE_NOTAM, MAP_STYLE_NAVAREA
#MAP_STYLE_NAVAREA=liberty
